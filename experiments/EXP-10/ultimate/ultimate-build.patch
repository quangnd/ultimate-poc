diff --git a/src/web/ImportPreview.tsx b/src/web/ImportPreview.tsx
new file mode 100644
index 0000000..632464b
--- /dev/null
+++ b/src/web/ImportPreview.tsx
@@ -0,0 +1,248 @@
+/** The import preview (US-07): what replacing the stored release with the chosen file would change, from `diffReleases`. */
+import { useMemo } from 'react'
+import { diffReleases, type FieldChange, type GateState, type Link, type ReleaseDiff, type TaskField } from '../domain/diff'
+import type { IsoDate, ReleaseDocument, Status } from '../domain/types'
+import { deltaText, formatDate, slipText, slipTone, STATUS_LABEL } from './view'
+
+const FIELD_LABEL: Record<TaskField, string> = {
+  title: 'Title',
+  stream: 'Stream',
+  ownerRole: 'Owner role',
+  status: 'Status',
+  estimateDays: 'Estimate (days)',
+  targetDate: 'Target',
+  gate: 'Gate',
+}
+
+const GATE_STATE_LABEL: Record<GateState, string> = { missing: 'not defined', open: 'open', done: 'done' }
+
+const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`
+
+interface Props {
+  /** The stored release and the chosen file, both validated. */
+  stored: ReleaseDocument
+  imported: ReleaseDocument
+  /** Unsaved changes in the editor: the preview compares with the stored release, never with these. */
+  unsavedChanges: number
+}
+
+export function ImportPreview({ stored, imported, unsavedChanges }: Props) {
+  const diff = useMemo(() => diffReleases(stored, imported), [stored, imported])
+  return (
+    <section className="import-preview" aria-labelledby="import-preview-title">
+      <h2 id="import-preview-title">What changes</h2>
+      <p className="muted">
+        Compared with the stored release
+        {unsavedChanges > 0 && <>, not with your {plural(unsavedChanges, 'unsaved change')} in the editor</>}.
+      </p>
+      {diff.unchanged ? (
+        <p>This file matches the stored release: importing it changes nothing.</p>
+      ) : (
+        <dl className="diff-rows">
+          <Readiness diff={diff} />
+          <Forecast diff={diff} stored={stored} imported={imported} />
+          <Tasks diff={diff} stored={stored} imported={imported} />
+          <Links links={diff.links} />
+          <Release diff={diff} />
+          <Workstreams workstreams={diff.workstreams} />
+        </dl>
+      )}
+    </section>
+  )
+}
+
+function Row({ label, children }: { label: string; children: React.ReactNode }) {
+  return (
+    <div className="diff-row">
+      <dt>{label}</dt>
+      <dd>{children}</dd>
+    </div>
+  )
+}
+
+function Change({ before, after }: { before: React.ReactNode; after: React.ReactNode }) {
+  return (
+    <span className="diff-change">
+      <span className="diff-old">{before}</span> <span className="diff-arrow">→</span> <span className="diff-new">{after}</span>
+    </span>
+  )
+}
+
+const Id = ({ id }: { id: string }) => <span className="id">{id}</span>
+
+const none = <span className="muted">none</span>
+
+function Verdict({ ready }: { ready: boolean }) {
+  return <span className={ready ? 'verdict-chip verdict-chip-ready' : 'verdict-chip verdict-chip-not-ready'}>{ready ? 'Ready' : 'Not ready'}</span>
+}
+
+function Readiness({ diff }: { diff: ReleaseDiff }) {
+  const { before, after, gates } = diff.readiness
+  return (
+    <Row label="Readiness">
+      {before === after ? (
+        <span>
+          <Verdict ready={after} /> <span className="muted">· unchanged</span>
+        </span>
+      ) : (
+        <Change before={<Verdict ready={before} />} after={<Verdict ready={after} />} />
+      )}
+      {gates.length > 0 && (
+        <ul className="diff-list">
+          {gates.map((g) => (
+            <li key={g.gate}>
+              Gate <code>{g.gate}</code>: <Change before={GATE_STATE_LABEL[g.before]} after={GATE_STATE_LABEL[g.after]} />
+            </li>
+          ))}
+        </ul>
+      )}
+    </Row>
+  )
+}
+
+/** Every task done (or none): the dashboard says "Complete" there, not a finish date. */
+const isComplete = (doc: ReleaseDocument) => doc.tasks.every((t) => t.status === 'done')
+
+function Forecast({ diff, stored, imported }: { diff: ReleaseDiff; stored: ReleaseDocument; imported: ReleaseDocument }) {
+  const f = diff.forecast
+  const finish = (date: IsoDate, doc: ReleaseDocument) => (isComplete(doc) ? 'Complete' : formatDate(date))
+  const slip = (days: number | null, doc: ReleaseDocument) =>
+    days === null ? <span className="muted">no target</span> : isComplete(doc) ? '—' : <span className={`slip slip-${slipTone(days)}`}>{slipText(days)}</span>
+  const comparable = !isComplete(stored) && !isComplete(imported)
+  return (
+    <>
+      <Row label="Estimated finish">
+        <span className="diff-line">
+          <Change before={finish(f.beforeFinishDate, stored)} after={finish(f.afterFinishDate, imported)} />
+          {comparable && (
+            <span className={`delta ${f.deltaWorkingDays > 0 ? 'delta-later' : ''}`}>{deltaText(f.deltaWorkingDays)}</span>
+          )}
+          <span className="estimate-tag">Estimate, not a commitment</span>
+        </span>
+      </Row>
+      {(f.beforeSlipDays !== null || f.afterSlipDays !== null) && (
+        <Row label="Slip vs target">
+          <Change before={slip(f.beforeSlipDays, stored)} after={slip(f.afterSlipDays, imported)} />
+        </Row>
+      )}
+    </>
+  )
+}
+
+function FieldValue({ field, value }: { field: TaskField; value: FieldChange['before'] }) {
+  if (value === null) return none
+  if (field === 'status') return <>{STATUS_LABEL[value as Status]}</>
+  if (field === 'targetDate') return <>{formatDate(value as IsoDate)}</>
+  if (field === 'gate') return <code>{value}</code>
+  return <>{value}</>
+}
+
+function IdList({ ids }: { ids: string[] }) {
+  return (
+    <span className="diff-ids">
+      {ids.map((id) => (
+        <Id key={id} id={id} />
+      ))}
+    </span>
+  )
+}
+
+function Tasks({ diff, stored, imported }: { diff: ReleaseDiff; stored: ReleaseDocument; imported: ReleaseDocument }) {
+  const { added, removed, changed } = diff.tasks
+  if (added.length + removed.length + changed.length === 0) return null
+  const titleOf = (id: string) => (imported.tasks.find((t) => t.id === id) ?? stored.tasks.find((t) => t.id === id))?.title
+  return (
+    <Row label="Tasks">
+      {added.length > 0 && (
+        <p className="diff-line">
+          <strong>{plural(added.length, 'task')} added</strong> <IdList ids={added} />
+        </p>
+      )}
+      {removed.length > 0 && (
+        <p className="diff-line">
+          <strong>{plural(removed.length, 'task')} removed</strong> <IdList ids={removed} />
+        </p>
+      )}
+      {changed.length > 0 && (
+        <>
+          <p>
+            <strong>{plural(changed.length, 'task')} changed</strong>
+          </p>
+          <ul className="diff-list">
+            {changed.map(({ id, changes }) => (
+              <li key={id} className="diff-task">
+                <span>
+                  <Id id={id} /> <span className="muted">{titleOf(id)}</span>
+                </span>
+                <ul className="diff-fields">
+                  {changes.map((c) => (
+                    <li key={c.field}>
+                      <span className="diff-field">{FIELD_LABEL[c.field]}:</span>{' '}
+                      <Change before={<FieldValue field={c.field} value={c.before} />} after={<FieldValue field={c.field} value={c.after} />} />
+                    </li>
+                  ))}
+                </ul>
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+    </Row>
+  )
+}
+
+function Links({ links }: { links: ReleaseDiff['links'] }) {
+  if (links.added.length + links.removed.length === 0) return null
+  const list = (items: Link[]) => (
+    <ul className="diff-links">
+      {items.map(({ from, to }) => (
+        <li key={`${from}\u0000${to}`}>
+          <Id id={from} /> <span className="diff-arrow">→</span> <Id id={to} />
+        </li>
+      ))}
+    </ul>
+  )
+  return (
+    <Row label="Links">
+      {links.added.length > 0 && (
+        <div>
+          <strong>{plural(links.added.length, 'link')} added</strong>
+          {list(links.added)}
+        </div>
+      )}
+      {links.removed.length > 0 && (
+        <div>
+          <strong>{plural(links.removed.length, 'link')} removed</strong>
+          {list(links.removed)}
+        </div>
+      )}
+    </Row>
+  )
+}
+
+function Release({ diff }: { diff: ReleaseDiff }) {
+  if (diff.release.length === 0) return null
+  return (
+    <Row label="Release dates">
+      <ul className="diff-list">
+        {diff.release.map((c) => (
+          <li key={c.field}>
+            <span className="diff-field">{c.field === 'startDate' ? 'Start' : 'Target'}:</span>{' '}
+            <Change before={c.before === null ? none : formatDate(c.before)} after={c.after === null ? none : formatDate(c.after)} />
+          </li>
+        ))}
+      </ul>
+    </Row>
+  )
+}
+
+function Workstreams({ workstreams }: { workstreams: ReleaseDiff['workstreams'] }) {
+  const { added, removed } = workstreams
+  if (added.length + removed.length === 0) return null
+  return (
+    <Row label="Streams">
+      {added.length > 0 && <p><strong>Added:</strong> {added.join(', ')}</p>}
+      {removed.length > 0 && <p><strong>Removed:</strong> {removed.join(', ')}</p>}
+    </Row>
+  )
+}

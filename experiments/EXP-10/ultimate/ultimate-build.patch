+    expect(diffReleases(SAMPLE, later).forecast).toMatchObject({ beforeFinishDate: '2027-02-10', afterFinishDate: '2027-02-17', deltaWorkingDays: 5 })
+    // A Saturday start still means day 0 = the Monday after: 2027-01-09 → Mon 2027-01-11, 5 working days after Mon 2027-01-04.
+    const saturday = modified((d) => void (d.release.startDate = '2027-01-09'))

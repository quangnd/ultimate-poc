+})
+
+describe('diffReleases: purity and order independence (criterion 9)', () => {
+  /** Reverses (or rotates) the tasks, the predecessors and the workstreams of a copy. */
+  function shuffled(d: ReleaseDocument, by: 'reverse' | 'rotate'): ReleaseDocument {
+    const reorder = <T>(items: T[]): T[] => (by === 'reverse' ? [...items].reverse() : [...items.slice(3), ...items.slice(0, 3)])
+    const copy = clone(d)
+    copy.tasks = reorder(copy.tasks)
+    for (const t of copy.tasks) t.predecessors = reorder(t.predecessors).reverse()
+    copy.workstreams = reorder(copy.workstreams)
+    return copy
+  }
+
+  // A pair that differs in every category, so that every list of the result is non-trivial.
+  const before = SAMPLE
+  const after = modified((d) => {
+    d.release.targetDate = '2027-02-26'
+    d.workstreams = ['FW', 'SPS', 'Security', 'App', 'QA', 'Docs']
+    taskOf(d, 'FW-03').estimateDays = 8
+    taskOf(d, 'FW-03').title = 'Fix display timing'
+    taskOf(d, 'SEC-01').status = 'in_progress'
+    taskOf(d, 'FW-05').predecessors = ['FW-02']
+    removeTask(d, 'QA-02')
+    d.tasks.push(extra('FW-07', ['FW-06', 'FW-04']), { ...extra('DOC-1'), stream: 'Docs' })
+  })
+
+  it('gives the same result for any ordering of tasks, predecessors and workstreams of either document', () => {
+    const expected = diffReleases(before, after)
+    expect(expected.unchanged).toBe(false)
+    expect(expected.tasks.added).toEqual(['DOC-1', 'FW-07'])
+    for (const a of ['reverse', 'rotate'] as const) {
+      for (const b of ['reverse', 'rotate'] as const) {
+        expect(diffReleases(shuffled(before, a), shuffled(after, b))).toEqual(expected)
+      }
+    }
+  })
+
+  it('is deterministic and does not mutate its inputs', () => {
+    const frozenBefore = deepFreeze(clone(before))
+    const frozenAfter = deepFreeze(clone(after))
+    const first = diffReleases(frozenBefore, frozenAfter)
+    expect(diffReleases(frozenBefore, frozenAfter)).toEqual(first)
+    expect(frozenBefore).toEqual(before)
+    expect(frozenAfter).toEqual(after)
+  })
+})
+
+function deepFreeze<T>(value: T): T {
+  if (typeof value === 'object' && value !== null && !Object.isFrozen(value)) {
+    Object.freeze(value)
+    for (const child of Object.values(value)) deepFreeze(child)
+  }
+  return value
+}

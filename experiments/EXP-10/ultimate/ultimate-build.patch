--- /dev/null
+++ b/tests/domain/diff.test.ts
@@ -0,0 +1,410 @@
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { diffReleases, TASK_FIELDS, type ReleaseDiff } from '../../src/domain/diff'
+import { assessReadiness } from '../../src/domain/readiness'
+import { schedule } from '../../src/domain/schedule'
+import { GATES, type ReleaseDocument, type Task } from '../../src/domain/types'
+import { validateDocument } from '../../src/domain/validate'
+
+const loaded = validateDocument(JSON.parse(readFileSync('fixtures/release.json', 'utf8')))
+if (!loaded.ok) throw new Error('fixture must be valid')
+/** The sample release (24 tasks, FW-03 = 5 days: finish Wed 2027-02-10, 2 working days before the target). */
+const SAMPLE: ReleaseDocument = loaded.document
+
+const clone = (d: ReleaseDocument): ReleaseDocument => structuredClone(d)
+
+/** A modified copy of `base` (the sample by default); it must still be a valid document, the precondition of diffReleases. */
+function modified(edit: (d: ReleaseDocument) => void, base: ReleaseDocument = SAMPLE): ReleaseDocument {
+  const d = clone(base)
+  edit(d)
+  const result = validateDocument(d)
+  if (!result.ok) throw new Error(`test document is invalid: ${result.errors.map((e) => e.message).join('; ')}`)
+  return d
+}
+
+/** Removes a task and every link to it. */
+function removeTask(d: ReleaseDocument, id: string): void {
+  d.tasks = d.tasks.filter((t) => t.id !== id)
+  for (const t of d.tasks) t.predecessors = t.predecessors.filter((p) => p !== id)
+}
+
+const taskOf = (d: ReleaseDocument, id: string): Task => d.tasks.find((t) => t.id === id)!
+
+/** A task in the sample's FW stream that no other task depends on. */
+const extra = (id: string, predecessors: string[] = []): Task => ({
+  id,
+  title: `Extra ${id}`,
+  stream: 'FW',
+  ownerRole: 'fw-engineer',
+  status: 'todo',
+  estimateDays: 1,
+  predecessors,
+})
+
+const EMPTY_LISTS = {
+  release: [],
+  workstreams: { added: [], removed: [] },
+  tasks: { added: [], removed: [], changed: [] },
+  links: { added: [], removed: [] },
+}
+
+/** Every list of a diff is empty. */
+const listsOf = (d: ReleaseDiff) => ({ release: d.release, workstreams: d.workstreams, tasks: d.tasks, links: d.links })
+
+describe('diffReleases: identity (criterion 1)', () => {
+  it('a document against itself or an equal copy is unchanged, with empty lists and a zero forecast delta', () => {
+    for (const other of [SAMPLE, clone(SAMPLE)]) {
+      const diff = diffReleases(SAMPLE, other)
+      expect(diff.unchanged).toBe(true)
+      expect(listsOf(diff)).toEqual(EMPTY_LISTS)
+      expect(diff.readiness).toEqual({ before: false, after: false, gates: [] })
+      expect(diff.forecast).toEqual({
+        beforeFinishDate: '2027-02-10',
+        afterFinishDate: '2027-02-10',
+        deltaWorkingDays: 0,
+        beforeSlipDays: -2,
+        afterSlipDays: -2,
+      })
+    }
+  })
+})
+
+describe('diffReleases: tasks added and removed (criterion 2)', () => {
+  it('matches by id, sorts in code-unit order (not localeCompare) and never also reports them as changed', () => {
+    const after = modified((d) => {
+      removeTask(d, 'QA-02')
+      removeTask(d, 'APP-04')
+      d.tasks.push(extra('a1'), extra('B2'), extra('FW-07', ['FW-06']))
+    })
+    const diff = diffReleases(SAMPLE, after)
+    // 'B2' < 'FW-07' < 'a1' by code unit; localeCompare would put 'a1' first.
+    expect(diff.tasks.added).toEqual(['B2', 'FW-07', 'a1'])
+    expect(diff.tasks.removed).toEqual(['APP-04', 'QA-02'])
+    expect(diff.tasks.changed).toEqual([])
+    expect(diffReleases(after, SAMPLE)).toMatchObject({ tasks: { added: ['APP-04', 'QA-02'], removed: ['B2', 'FW-07', 'a1'], changed: [] } })
+    expect(diff.unchanged).toBe(false)
+  })
+
+  it('ids that are names of inherited object properties are ordinary ids', () => {
+    const after = modified((d) => d.tasks.push(extra('constructor'), extra('__proto__'), extra('toString')))
+    expect(diffReleases(SAMPLE, after).tasks.added).toEqual(['__proto__', 'constructor', 'toString'])
+    expect(diffReleases(after, after).unchanged).toBe(true)
+  })
+})
+
+describe('diffReleases: tasks changed (criterion 3)', () => {
+  it('reports each differing field once, in TASK_FIELDS order, with null for an absent optional field', () => {
+    expect(TASK_FIELDS).toEqual(['title', 'stream', 'ownerRole', 'status', 'estimateDays', 'targetDate', 'gate'])
+    const after = modified((d) => {
+      // Edited in an order that differs from TASK_FIELDS: the report must not follow it.
+      const fw04 = taskOf(d, 'FW-04')
+      fw04.gate = 'fw-integrated' // moved here from FW-06
+      fw04.targetDate = '2027-02-01'
+      fw04.estimateDays = 6
+      fw04.status = 'in_progress'
+      fw04.ownerRole = 'fw-lead'
+      fw04.stream = 'SPS'
+      fw04.title = 'Over-the-air client'
+      const fw06 = taskOf(d, 'FW-06')
+      delete fw06.targetDate
+      delete fw06.gate
+      fw06.estimateDays = 1 // a 0-day task must be a gate
+    })
+    const changed = diffReleases(SAMPLE, after).tasks.changed
+    expect(changed.map((c) => c.id)).toEqual(['FW-04', 'FW-06'])
+    expect(changed[0]!.changes).toEqual([
+      { field: 'title', before: 'Build over-the-air update client', after: 'Over-the-air client' },
+      { field: 'stream', before: 'FW', after: 'SPS' },
+      { field: 'ownerRole', before: 'fw-engineer', after: 'fw-lead' },
+      { field: 'status', before: 'todo', after: 'in_progress' },
+      { field: 'estimateDays', before: 4, after: 6 },
+      { field: 'targetDate', before: null, after: '2027-02-01' },
+      { field: 'gate', before: null, after: 'fw-integrated' },
+    ])
+    expect(changed[1]!.changes).toEqual([
+      { field: 'estimateDays', before: 0, after: 1 },
+      { field: 'targetDate', before: '2027-01-22', after: null },
+      { field: 'gate', before: 'fw-integrated', after: null },
+    ])
+  })
+
+  it('reports only the differing field: FW-03 estimate 5 → 8', () => {
+    const after = modified((d) => void (taskOf(d, 'FW-03').estimateDays = 8))
+    expect(diffReleases(SAMPLE, after).tasks.changed).toEqual([
+      { id: 'FW-03', changes: [{ field: 'estimateDays', before: 5, after: 8 }] },
+    ])
+  })
+
+  it('does not list a task whose only difference is in predecessors, and sorts changed tasks by id', () => {
+    const linksOnly = modified((d) => void (taskOf(d, 'FW-05').predecessors = ['FW-04', 'FW-02']))
+    expect(diffReleases(SAMPLE, linksOnly).tasks.changed).toEqual([])
+
+    // 'qa-lower' sorts after every upper-case id by code unit, wherever it sits in the document
+    const before = modified((d) => void d.tasks.unshift(extra('qa-lower')))
+    const after = modified((d) => {
+      taskOf(d, 'SEC-01').title = 'x'
+      taskOf(d, 'qa-lower').title = 'z'
+      taskOf(d, 'APP-02').title = 'y'
+    }, before)
+    expect(diffReleases(before, after).tasks.changed.map((c) => c.id)).toEqual(['APP-02', 'SEC-01', 'qa-lower'])
+  })
+})
+
+describe('diffReleases: links (criterion 4)', () => {
+  it('lists links present on one side only, including the links of added and removed tasks, sorted by to then from', () => {
+    const after = modified((d) => {
+      // changed: FW-05 loses FW-04 and gains FW-02; QA-02 is removed with its links QA-01 → QA-02 and FW-06 → QA-02,
+      // and QA-03 keeps its other links but loses QA-02; new tasks NEW-1 (after FW-06 and QA-01)
+      // and A-1 (after QA-04) sort by `to` first: A-1 comes first although its `from` sorts last.
+      taskOf(d, 'FW-05').predecessors = ['FW-02']
+      removeTask(d, 'QA-02')
+      d.tasks.push(extra('NEW-1', ['QA-01', 'FW-06']), extra('A-1', ['QA-04']))
+    })
+    const { links } = diffReleases(SAMPLE, after)
+    expect(links.added).toEqual([
+      { from: 'QA-04', to: 'A-1' },
+      { from: 'FW-02', to: 'FW-05' },
+      { from: 'FW-06', to: 'NEW-1' },
+      { from: 'QA-01', to: 'NEW-1' },
+    ])
+    expect(links.removed).toEqual([
+      { from: 'FW-04', to: 'FW-05' },
+      { from: 'FW-06', to: 'QA-02' },
+      { from: 'QA-01', to: 'QA-02' },
+      { from: 'QA-02', to: 'QA-03' },
+    ])
+  })
+
+  it('does not treat the order of ids in a predecessors array as a change', () => {
+    const after = modified((d) => {
+      for (const t of d.tasks) t.predecessors = [...t.predecessors].reverse()
+    })
+    expect(taskOf(SAMPLE, 'QA-03').predecessors).not.toEqual(taskOf(after, 'QA-03').predecessors)
+    const diff = diffReleases(SAMPLE, after)
+    expect(diff.links).toEqual({ added: [], removed: [] })
+    expect(diff.unchanged).toBe(true)
+  })
+})
+
+describe('diffReleases: release and workstreams (criterion 5)', () => {
+  it('lists startDate before targetDate, only when they differ, with an absent target as null', () => {
+    expect(diffReleases(SAMPLE, modified((d) => void (d.release.startDate = '2027-01-11'))).release).toEqual([
+      { field: 'startDate', before: '2027-01-04', after: '2027-01-11' },
+    ])
+    const both = modified((d) => {
+      d.release.targetDate = '2027-03-01'
+      d.release.startDate = '2027-01-05'
+    })
+    expect(diffReleases(SAMPLE, both).release).toEqual([
+      { field: 'startDate', before: '2027-01-04', after: '2027-01-05' },
+      { field: 'targetDate', before: '2027-02-12', after: '2027-03-01' },
+    ])
+    const noTarget = modified((d) => void delete d.release.targetDate)
+    expect(diffReleases(SAMPLE, noTarget).release).toEqual([{ field: 'targetDate', before: '2027-02-12', after: null }])
+    expect(diffReleases(noTarget, SAMPLE).release).toEqual([{ field: 'targetDate', before: null, after: '2027-02-12' }])
+  })
+
+  it('compares workstream names as sets, each list sorted in code-unit order; a reordering alone is no change', () => {
+    const reordered = modified((d) => void d.workstreams.reverse())
+    expect(diffReleases(SAMPLE, reordered).workstreams).toEqual({ added: [], removed: [] })
+    expect(diffReleases(SAMPLE, reordered).unchanged).toBe(true)
+
+    // Unused streams come and go; the sample's streams keep their tasks. 'Old2' < 'old1' by code unit.
+    const before = modified((d) => void d.workstreams.push('old1', 'Old2', 'Same'))
+    const after = modified((d) => void (d.workstreams = ['Zeta', 'QA', 'alpha', 'FW', 'Same', 'SPS', 'Beta', 'Security', 'App']))
+    expect(diffReleases(before, after).workstreams).toEqual({ added: ['Beta', 'Zeta', 'alpha'], removed: ['Old2', 'old1'] })
+  })
+})
+
+describe('diffReleases: unchanged (criterion 6)', () => {
+  // Each variant changes one category only, so each list that makes `unchanged` false is exercised on its own.
+  const withDocs = modified((d) => void d.workstreams.push('Docs'))
+  const withLeaf = modified((d) => void d.tasks.push(extra('FW-07')))
+  const variants: [string, ReleaseDocument, ReleaseDocument][] = [
+    ['release', SAMPLE, modified((d) => void (d.release.startDate = '2027-01-05'))],
+    ['workstreams added', SAMPLE, withDocs],
+    ['workstreams removed', withDocs, SAMPLE],
+    ['tasks added', SAMPLE, withLeaf],
+    ['tasks removed', withLeaf, SAMPLE],
+    ['tasks changed', SAMPLE, modified((d) => void (taskOf(d, 'FW-04').title = 'Renamed'))],
+    ['links added', SAMPLE, modified((d) => void taskOf(d, 'FW-04').predecessors.push('FW-02'))],
+    ['links removed', SAMPLE, modified((d) => void (taskOf(d, 'SPS-04').predecessors = ['SPS-03']))],
+  ]
+
+  it.each(variants)('is false when only %s differ, and the other lists stay empty', (name, before, after) => {
+    const diff = diffReleases(before, after)
+    expect(diff.unchanged).toBe(false)
+    const lengths: Record<string, number> = {
+      release: diff.release.length,
+      'workstreams added': diff.workstreams.added.length,
+      'workstreams removed': diff.workstreams.removed.length,
+      'tasks added': diff.tasks.added.length,
+      'tasks removed': diff.tasks.removed.length,
+      'tasks changed': diff.tasks.changed.length,
+      'links added': diff.links.added.length,
+      'links removed': diff.links.removed.length,
+    }
+    expect(Object.keys(lengths).filter((key) => lengths[key]! > 0)).toEqual([name])
+  })
+})
+
+describe('diffReleases: readiness and gates (criterion 7)', () => {
+  const gateTask = (d: ReleaseDocument, gate: (typeof GATES)[number]) => d.tasks.find((t) => t.gate === gate)!
+
+  it('reports ready of each document as assessReadiness does', () => {
+    const ready = modified((d) => {
+      for (const t of d.tasks) t.status = 'done'
+    })
+    expect(assessReadiness(ready, schedule(ready)).ready).toBe(true)
+    expect(diffReleases(SAMPLE, ready).readiness).toMatchObject({ before: false, after: true })
+    expect(diffReleases(ready, SAMPLE).readiness).toMatchObject({ before: true, after: false })
+    expect(diffReleases(ready, ready).readiness).toEqual({ before: true, after: true, gates: [] })
+  })
+
+  it('lists each gate whose state differs (missing, open, done) in GATES order', () => {
+    const before = modified((d) => {
+      // fw-integrated: done → open; security-verified: open → done; app-integration: open → missing; qa-complete: missing → open
+      gateTask(d, 'fw-integrated').status = 'done'
+      const qa = gateTask(d, 'qa-complete')
+      delete qa.gate
+      qa.estimateDays = 1
+    })
+    const after = modified((d) => {
+      gateTask(d, 'fw-integrated').status = 'todo'
+      gateTask(d, 'security-verified').status = 'done'
+      const app = gateTask(d, 'app-integration')
+      delete app.gate
+      app.estimateDays = 1
+    })
+    expect(diffReleases(before, after).readiness.gates).toEqual([
+      { gate: 'fw-integrated', before: 'done', after: 'open' },
+      { gate: 'security-verified', before: 'open', after: 'done' },
+      { gate: 'app-integration', before: 'open', after: 'missing' },
+      { gate: 'qa-complete', before: 'missing', after: 'open' },
+    ])
+    expect(diffReleases(after, before).readiness.gates.map((g) => `${g.gate} ${g.before}>${g.after}`)).toEqual([
+      'fw-integrated open>done',
+      'security-verified done>open',
+      'app-integration missing>open',
+      'qa-complete open>missing',
+    ])
+  })
+
+  it('does not list a gate that moves to another task in the same state', () => {
+    const after = modified((d) => {
+      delete taskOf(d, 'SEC-05').gate
+      taskOf(d, 'SEC-05').estimateDays = 1
+      taskOf(d, 'SEC-04').gate = 'security-verified' // SEC-04 is todo like SEC-05: the gate stays open
+    })
+    const diff = diffReleases(SAMPLE, after)
+    expect(diff.readiness.gates).toEqual([])
+    expect(diff.tasks.changed.map((c) => c.id)).toEqual(['SEC-04', 'SEC-05']) // the move itself is a task change
+  })
+
+  it('lists a gate that moves to a task in another state', () => {
+    const after = modified((d) => {
+      delete taskOf(d, 'QA-04').gate
+      taskOf(d, 'QA-04').estimateDays = 1
+      taskOf(d, 'QA-01').gate = 'qa-complete'
+      taskOf(d, 'QA-01').status = 'done'
+    })
+    expect(diffReleases(SAMPLE, after).readiness.gates).toEqual([{ gate: 'qa-complete', before: 'open', after: 'done' }])
+  })
+})
+
+describe('diffReleases: forecast (criterion 8)', () => {
+  const delayed = modified((d) => void (taskOf(d, 'FW-03').estimateDays = 8))
+
+  it('reports the firmware-delay scenario: finish Wed 10 Feb → Mon 15 Feb 2027, +3 working days, slip −2 → +1', () => {
+    expect(diffReleases(SAMPLE, delayed).forecast).toEqual({
+      beforeFinishDate: '2027-02-10',
+      afterFinishDate: '2027-02-15',
+      deltaWorkingDays: 3,
+      beforeSlipDays: -2,
+      afterSlipDays: 1,
+    })
+    expect(diffReleases(delayed, SAMPLE).forecast).toEqual({
+      beforeFinishDate: '2027-02-15',
+      afterFinishDate: '2027-02-10',
+      deltaWorkingDays: -3,
+      beforeSlipDays: 1,
+      afterSlipDays: -2,
+    })
+  })
+
+  it('takes the finish dates and slip from the scheduler and null when a document has no release target', () => {
+    const noTarget = modified((d) => void delete d.release.targetDate)
+    const diff = diffReleases(noTarget, delayed).forecast
+    expect(diff.beforeSlipDays).toBeNull()
+    expect(diff.afterSlipDays).toBe(schedule(delayed).slipDays)
+    expect(diff.beforeFinishDate).toBe(schedule(noTarget).finishDate)
+    expect(diff.afterFinishDate).toBe(schedule(delayed).finishDate)
+    expect(diffReleases(delayed, noTarget).forecast.afterSlipDays).toBeNull()
+  })

@@ -0,0 +1,44 @@
+import { readFile } from 'node:fs/promises'
+import { resolve } from 'node:path'
+import { expect } from '@playwright/test'
+import { test } from './api'
+
+test('the import preview shows the firmware delay before it replaces the stored release, and the dashboard shows it after', async ({ page, api }) => {
+  void api // starts the release API on an empty data dir
+  const summary = page.getByRole('region', { name: 'Summary' })
+
+  // The sample release is stored: estimated finish Wed 10 Feb 2027.
+  await page.goto('/')
+  await page.getByRole('button', { name: 'Load the sample release' }).click()
+  await expect(summary).toContainText(/Estimated finish\s*Wed 10 Feb 2027/)
+
+  // The file to import: the sample with FW-03 at 8 days instead of 5 (fixtures/README.md, "Firmware-delay scenario").
+  const sample = JSON.parse(await readFile(resolve(import.meta.dirname, '../fixtures/release.json'), 'utf8')) as {
+    tasks: { id: string; estimateDays: number }[]
+  }
+  sample.tasks.find((t) => t.id === 'FW-03')!.estimateDays = 8
+  await page.locator('input[type=file]').setInputFiles({
+    name: 'fw-delay.json',
+    mimeType: 'application/json',
+    buffer: Buffer.from(JSON.stringify(sample, null, 2)),
+  })
+
+  // The panel shows what would change: one task, one field, the finish three working days later. Nothing is stored yet.
+  const panel = page.getByRole('region', { name: /Replace the stored release with/ })
+  const preview = panel.getByRole('region', { name: 'What changes' })
+  await expect(preview).toContainText('1 task changed')
+  await expect(preview).toContainText('FW-03')
+  await expect(preview).toContainText('Estimate (days): 5 → 8')
+  await expect(preview).toContainText('Wed 10 Feb 2027 → Mon 15 Feb 2027')
+  await expect(preview).toContainText('+3 working days later')
+  await expect(preview).toContainText('2 working days early → 1 working day late')
+  await expect(preview).toContainText('Estimate, not a commitment')
+  await expect(preview).not.toContainText(/tasks? (added|removed)|links? (added|removed)/)
+  await expect(summary).toContainText(/Estimated finish\s*Wed 10 Feb 2027/)
+
+  // Confirming stores it: the dashboard shows the delayed finish.
+  await panel.getByRole('button', { name: 'Replace stored release' }).click()
+  await expect(page.getByText('Imported fw-delay.json.')).toBeVisible()
+  await expect(summary).toContainText(/Estimated finish\s*Mon 15 Feb 2027/)
+  await expect(summary).toContainText('1 working day late')
+})
diff --git a/src/domain/diff.ts b/src/domain/diff.ts
new file mode 100644
index 0000000..69671f5
--- /dev/null
+++ b/src/domain/diff.ts
@@ -0,0 +1,196 @@
+/**
+ * What changes when one release document replaces another (US-07 import preview, with US-04 forecast and US-05 readiness).
+ * Pure: no I/O, no clock, no randomness; the inputs are not mutated and the order of tasks, predecessors and workstreams
+ * in either document never affects the result. Precondition, not re-checked: both documents passed `validateDocument`.
+ * The forecast and the readiness come from `schedule` and `assessReadiness`; nothing of them is reimplemented here.
+ */
+import { slipDays } from './calendar'
+import { assessReadiness } from './readiness'
+import { schedule } from './schedule'
+import { GATES, type Gate, type IsoDate, type ReleaseDocument, type Task } from './types'
+
+/** The task fields compared, in this order. `predecessors` is not a field here: links are reported in `links`. */
+export const TASK_FIELDS = ['title', 'stream', 'ownerRole', 'status', 'estimateDays', 'targetDate', 'gate'] as const
+export type TaskField = (typeof TASK_FIELDS)[number]
+
+export interface FieldChange {
+  field: TaskField
+  /** the value in `before`/`after`; an absent optional field (`targetDate`, `gate`) is null */
+  before: string | number | null
+  after: string | number | null
+}
+
+export interface TaskChange {
+  id: string
+  /** only fields whose value differs, in TASK_FIELDS order; never empty */
+  changes: FieldChange[]
+}
+
+/** A finish-to-start link: `to` lists `from` among its predecessors. */
+export interface Link {
+  from: string
+  to: string
+}
+
+export type GateState = 'missing' | 'open' | 'done'
+
+export interface GateChange {
+  gate: Gate
+  before: GateState
+  after: GateState
+}
+
+export interface ReleaseFieldChange {
+  field: 'startDate' | 'targetDate'
+  before: IsoDate | null
+  after: IsoDate | null
+}
+
+export interface ReleaseDiff {
+  /** true when release, workstreams, tasks and links all have no change */
+  unchanged: boolean
+  /** only differing fields, startDate before targetDate; an absent targetDate is null */
+  release: ReleaseFieldChange[]
+  /** stream names in one document but not the other, each sorted; a reordering alone is not a change */
+  workstreams: { added: string[]; removed: string[] }
+  tasks: {
+    /** ids only in `after`, sorted */
+    added: string[]
+    /** ids only in `before`, sorted */
+    removed: string[]
+    /** ids in both with at least one differing field, sorted by id */
+    changed: TaskChange[]
+  }
+  /** links only in `after` / only in `before` (including links of added or removed tasks), sorted by `to`, then `from` */
+  links: { added: Link[]; removed: Link[] }
+  readiness: {
+    /** `assessReadiness(...).ready` of each document */
+    before: boolean
+    after: boolean
+    /** one entry per mandatory gate whose state differs, in GATES order (src/domain/types.ts) */
+    gates: GateChange[]
+  }
+  forecast: {
+    /** `schedule(doc).finishDate` of each document */
+    beforeFinishDate: IsoDate
+    afterFinishDate: IsoDate
+    /** working days from the before finish date to the after finish date: positive = later, negative = earlier, 0 = same */
+    deltaWorkingDays: number
+    /** `schedule(doc).slipDays` of each document; null when that document has no release targetDate */
+    beforeSlipDays: number | null
+    afterSlipDays: number | null
+  }
+}
+
+/** Code-unit order (not localeCompare), so the result does not depend on the runtime's locale. */
+const compareStrings = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0)
+
+const sorted = (values: Iterable<string>): string[] => [...values].sort(compareStrings)
+
+/** Members of `a` that are not in `b`, sorted. */
+const without = (a: ReadonlySet<string>, b: ReadonlySet<string>): string[] => sorted([...a].filter((value) => !b.has(value)))
+
+/** The value of a compared task field, with an absent optional field as null. */
+const fieldValue = (task: Task, field: TaskField): string | number | null => task[field] ?? null
+
+/** Every link of a document, keyed by the pair, so that predecessor order and repeats do not matter. */
+function linksOf(doc: ReleaseDocument): Map<string, Link> {
+  const links = new Map<string, Link>()
+  for (const task of doc.tasks) {
+    for (const from of task.predecessors) links.set(JSON.stringify([from, task.id]), { from, to: task.id })
+  }
+  return links
+}
+
+/** Links in `a` that are not in `b`, sorted by `to`, then `from`. */
+function linksWithout(a: Map<string, Link>, b: Map<string, Link>): Link[] {
+  return [...a].filter(([key]) => !b.has(key)).map(([, link]) => link).sort((x, y) => compareStrings(x.to, y.to) || compareStrings(x.from, y.from))
+}
+
+function gateStates(doc: ReleaseDocument): Record<Gate, GateState> {
+  const state = (gate: Gate): GateState => {
+    const task = doc.tasks.find((t) => t.gate === gate)
+    return task === undefined ? 'missing' : task.status === 'done' ? 'done' : 'open'
+  }
+  return Object.fromEntries(GATES.map((gate) => [gate, state(gate)])) as Record<Gate, GateState>
+}
+
+export function diffReleases(before: ReleaseDocument, after: ReleaseDocument): ReleaseDiff {
+  const release: ReleaseFieldChange[] = []
+  if (before.release.startDate !== after.release.startDate) {
+    release.push({ field: 'startDate', before: before.release.startDate, after: after.release.startDate })
+  }
+  const beforeTarget = before.release.targetDate ?? null
+  const afterTarget = after.release.targetDate ?? null
+  if (beforeTarget !== afterTarget) release.push({ field: 'targetDate', before: beforeTarget, after: afterTarget })
+
+  const beforeStreams = new Set(before.workstreams)
+  const afterStreams = new Set(after.workstreams)
+  const workstreams = { added: without(afterStreams, beforeStreams), removed: without(beforeStreams, afterStreams) }
+
+  // Maps, not objects: a task id such as `constructor` or `__proto__` must not find an inherited property.
+  const beforeTasks = new Map(before.tasks.map((task) => [task.id, task]))
+  const afterTasks = new Map(after.tasks.map((task) => [task.id, task]))
+  const beforeIds = new Set(beforeTasks.keys())
+  const afterIds = new Set(afterTasks.keys())
+  const changed: TaskChange[] = []
+  for (const id of sorted(beforeIds)) {
+    const was = beforeTasks.get(id)!
+    const now = afterTasks.get(id)
+    if (now === undefined) continue
+    const changes: FieldChange[] = []
+    for (const field of TASK_FIELDS) {
+      const oldValue = fieldValue(was, field)
+      const newValue = fieldValue(now, field)
+      if (oldValue !== newValue) changes.push({ field, before: oldValue, after: newValue })
+    }
+    if (changes.length > 0) changed.push({ id, changes })
+  }
+  const tasks = {
+    added: without(afterIds, beforeIds),
+    removed: without(beforeIds, afterIds),
+    changed,
+  }
+
+  const beforeLinks = linksOf(before)
+  const afterLinks = linksOf(after)
+  const links = { added: linksWithout(afterLinks, beforeLinks), removed: linksWithout(beforeLinks, afterLinks) }
+
+  const beforeForecast = schedule(before)
+  const afterForecast = schedule(after)
+  const beforeGates = gateStates(before)
+  const afterGates = gateStates(after)
+
+  return {
+    unchanged:
+      release.length === 0 &&
+      workstreams.added.length === 0 &&
+      workstreams.removed.length === 0 &&
+      tasks.added.length === 0 &&
+      tasks.removed.length === 0 &&
+      tasks.changed.length === 0 &&
+      links.added.length === 0 &&
+      links.removed.length === 0,
+    release,
+    workstreams,
+    tasks,
+    links,
+    readiness: {
+      before: assessReadiness(before, beforeForecast).ready,
+      after: assessReadiness(after, afterForecast).ready,
+      gates: GATES.filter((gate) => beforeGates[gate] !== afterGates[gate]).map((gate) => ({
+        gate,
+        before: beforeGates[gate],
+        after: afterGates[gate],
+      })),
+    },
+    forecast: {
+      beforeFinishDate: beforeForecast.finishDate,
+      afterFinishDate: afterForecast.finishDate,
+      // slipDays(target, finish) is positive when `finish` is later: the before finish is the reference here.
+      deltaWorkingDays: slipDays(beforeForecast.finishDate, afterForecast.finishDate),
+      beforeSlipDays: beforeForecast.slipDays ?? null,
+      afterSlipDays: afterForecast.slipDays ?? null,
+    },
+  }
+}

diff --git a/e2e/import-preview.spec.ts b/e2e/import-preview.spec.ts
new file mode 100644
index 0000000..1647b8e
--- /dev/null
+++ b/e2e/import-preview.spec.ts
@@ -0,0 +1,70 @@
+import { readFile, writeFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { expect } from '@playwright/test'
+import { test } from './api'
+
+const SAMPLE = 'fixtures/release.json'
+
+// US-07 import preview: the firmware-delay scenario of fixtures/README.md. FW-03 goes from 5 to 8 working days, which
+// moves the estimated finish from Wed 10 Feb 2027 to Mon 15 Feb 2027 (+3 working days).
+test('the import preview shows the FW-03 delay before it is confirmed, then the dashboard shows the delayed finish', async ({ page, api }) => {
+  const summary = page.getByRole('region', { name: 'Summary' })
+  const preview = page.getByRole('region', { name: 'What would change' })
+
+  // The sample release is stored.
+  await writeFile(join(api.dataDir, 'release.json'), await readFile(SAMPLE, 'utf8'))
+  await page.goto('/')
+  await expect(summary).toContainText(/Estimated finish\s*Wed 10 Feb 2027/)
+
+  // The stored file itself changes nothing: the panel says so instead of listing empty sections.
+  await page.locator('input[type=file]').setInputFiles(SAMPLE)
+  await expect(preview).toContainText('This file matches the stored release.')
+  await expect(preview.getByRole('heading', { level: 3 })).toHaveCount(0)
+
+  // A file in which FW-03 has 8 working days instead of 5.
+  const sample = JSON.parse(await readFile(SAMPLE, 'utf8')) as { tasks: { id: string; estimateDays: number }[] }
+  sample.tasks.find((t) => t.id === 'FW-03')!.estimateDays = 8
+  await page.locator('input[type=file]').setInputFiles({
+    name: 'firmware-delay.json',
+    mimeType: 'application/json',
+    buffer: Buffer.from(JSON.stringify(sample, null, 2)),
+  })
+
+  // The panel shows what would change, and nothing is stored yet.
+  await expect(page.getByRole('heading', { name: /Replace the stored release with/ })).toBeVisible()
+  await expect(preview).toBeVisible()
+  await expect(preview).toContainText('Tasks: 0 added, 0 removed, 1 changed')
+  const fw03 = preview.getByRole('listitem').filter({ hasText: 'FW-03' }).first()
+  await expect(fw03).toContainText(/Estimate \(working days\)\s*5 → 8/)
+  await expect(preview).toContainText(/Estimated finish\s*Wed 10 Feb 2027 → Mon 15 Feb 2027\s*\+3 working days later/)
+  await expect(preview).toContainText(/Slip against the target\s*2 working days early → 1 working day late/)
+  await expect(preview).toContainText('Estimate, not a commitment')
+  await expect(preview).toContainText(/Not ready → Not ready\s*\(no change\)/)
+  const stored = (await (await page.request.get('/api/release')).json()) as { tasks: { id: string; estimateDays: number }[] }
+  expect(stored.tasks.find((t) => t.id === 'FW-03')?.estimateDays).toBe(5)
+
+  // Confirming stores the file; the dashboard shows the delayed finish.
+  await page.getByRole('button', { name: 'Replace stored release' }).click()
+  await expect(page.getByText('Imported firmware-delay.json.')).toBeVisible()
+  await expect(summary).toContainText(/Estimated finish\s*Mon 15 Feb 2027/)
+  await expect(preview).toHaveCount(0)
+})
+
+// An import in which every task is done: the dashboard says "Complete", but the preview still shows the forecast values.
+test('the import preview keeps the forecast figures when the imported release has every task done', async ({ page, api }) => {
+  const preview = page.getByRole('region', { name: 'What would change' })
+  await writeFile(join(api.dataDir, 'release.json'), await readFile(SAMPLE, 'utf8'))
+  await page.goto('/')
+
+  const sample = JSON.parse(await readFile(SAMPLE, 'utf8')) as { tasks: { status: string }[] }
+  for (const task of sample.tasks) task.status = 'done'
+  await page.locator('input[type=file]').setInputFiles({
+    name: 'all-done.json',
+    mimeType: 'application/json',
+    buffer: Buffer.from(JSON.stringify(sample, null, 2)),
+  })
+
+  await expect(preview).toContainText(/Estimated finish\s*Wed 10 Feb 2027 → Fri 1 Jan 2027 \(complete\)\s*-28 working days earlier/)
+  await expect(preview).toContainText(/Slip against the target\s*2 working days early → 30 working days early/)
+  await expect(preview).toContainText(/Not ready → Ready/)
+})
diff --git a/src/domain/diff.ts b/src/domain/diff.ts
new file mode 100644
index 0000000..1f591ea
--- /dev/null
+++ b/src/domain/diff.ts
@@ -0,0 +1,196 @@
+/**
+ * What changes when one release document replaces another (US-07 import preview). Pure: no I/O, no clock, no randomness,
+ * inputs never mutated. The forecast and readiness come from `schedule` and `assessReadiness`, not from a second
+ * implementation. Precondition, not re-checked: both documents passed `validateDocument`.
+ *
+ * Every list is sorted in code-unit order (not `localeCompare`) and nothing depends on the order of tasks, predecessors
+ * or workstreams, so the result is the same for any reordering of either input.
+ */
+import { slipDays } from './calendar'
+import { assessReadiness } from './readiness'
+import { schedule } from './schedule'
+import { GATES, type Gate, type IsoDate, type ReleaseDocument, type Task } from './types'
+
+/** The task fields compared, in this order. `predecessors` is not a field here: links are reported in `links`. */
+export const TASK_FIELDS = ['title', 'stream', 'ownerRole', 'status', 'estimateDays', 'targetDate', 'gate'] as const
+export type TaskField = (typeof TASK_FIELDS)[number]
+
+export interface FieldChange {
+  field: TaskField
+  /** the value in `before`/`after`; an absent optional field (`targetDate`, `gate`) is null */
+  before: string | number | null
+  after: string | number | null
+}
+
+export interface TaskChange {
+  id: string
+  /** only fields whose value differs, in TASK_FIELDS order; never empty */
+  changes: FieldChange[]
+}
+
+/** A finish-to-start link: `to` lists `from` among its predecessors. */
+export interface Link {
+  from: string
+  to: string
+}
+
+export type GateState = 'missing' | 'open' | 'done'
+
+export interface GateChange {
+  gate: Gate
+  before: GateState
+  after: GateState
+}
+
+export interface ReleaseFieldChange {
+  field: 'startDate' | 'targetDate'
+  before: IsoDate | null
+  after: IsoDate | null
+}
+
+export interface ReleaseDiff {
+  /** true when release, workstreams, tasks and links all have no change */
+  unchanged: boolean
+  /** only differing fields, startDate before targetDate; an absent targetDate is null */
+  release: ReleaseFieldChange[]
+  /** stream names in one document but not the other, each sorted; a reordering alone is not a change */
+  workstreams: { added: string[]; removed: string[] }
+  tasks: {
+    /** ids only in `after`, sorted */
+    added: string[]
+    /** ids only in `before`, sorted */
+    removed: string[]
+    /** ids in both with at least one differing field, sorted by id */
+    changed: TaskChange[]
+  }
+  /** links only in `after` / only in `before` (including links of added or removed tasks), sorted by `to`, then `from` */
+  links: { added: Link[]; removed: Link[] }
+  readiness: {
+    /** `assessReadiness(...).ready` of each document */
+    before: boolean
+    after: boolean
+    /** one entry per mandatory gate whose state differs, in GATES order (src/domain/types.ts) */
+    gates: GateChange[]
+  }
+  forecast: {
+    /** `schedule(doc).finishDate` of each document */
+    beforeFinishDate: IsoDate
+    afterFinishDate: IsoDate
+    /** working days from the before finish date to the after finish date: positive = later, negative = earlier, 0 = same */
+    deltaWorkingDays: number
+    /** `schedule(doc).slipDays` of each document; null when that document has no release targetDate */
+    beforeSlipDays: number | null
+    afterSlipDays: number | null
+  }
+}
+
+/** Code-unit order, so the result does not depend on the runtime's locale (ADR-002 §5). */
+const compareStrings = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0)
+
+const sortedStrings = (values: Iterable<string>): string[] => [...values].sort(compareStrings)
+
+/** Values in `source` whose key is not in `other`. */
+function missingFrom<K, V>(source: Map<K, V>, other: Map<K, V>): V[] {
+  return [...source].filter(([key]) => !other.has(key)).map(([, value]) => value)
+}
+
+const compareLinks = (a: Link, b: Link): number => compareStrings(a.to, b.to) || compareStrings(a.from, b.from)
+
+/** The set of (predecessor, successor) pairs. The key is JSON, so no id can make two different pairs collide. */
+function linksOf(doc: ReleaseDocument): Map<string, Link> {
+  const links = new Map<string, Link>()
+  for (const task of doc.tasks) {
+    for (const from of task.predecessors) links.set(JSON.stringify([from, task.id]), { from, to: task.id })
+  }
+  return links
+}
+
+/** An absent optional field is null. */
+const fieldValue = (task: Task, field: TaskField): string | number | null => task[field] ?? null
+
+function gateState(doc: ReleaseDocument, gate: Gate): GateState {
+  const task = doc.tasks.find((t) => t.gate === gate)
+  return task === undefined ? 'missing' : task.status === 'done' ? 'done' : 'open'
+}
+
+export function diffReleases(before: ReleaseDocument, after: ReleaseDocument): ReleaseDiff {
+  const beforeTasks = new Map(before.tasks.map((t) => [t.id, t]))
+  const afterTasks = new Map(after.tasks.map((t) => [t.id, t]))
+
+  const added = sortedStrings(afterTasks.keys()).filter((id) => !beforeTasks.has(id))
+  const removed = sortedStrings(beforeTasks.keys()).filter((id) => !afterTasks.has(id))
+  const changed: TaskChange[] = []
+  for (const id of sortedStrings(beforeTasks.keys())) {
+    const was = beforeTasks.get(id)!
+    const now = afterTasks.get(id)
+    if (now === undefined) continue
+    const changes: FieldChange[] = []
+    for (const field of TASK_FIELDS) {
+      const b = fieldValue(was, field)
+      const a = fieldValue(now, field)
+      if (b !== a) changes.push({ field, before: b, after: a })
+    }
+    if (changes.length > 0) changed.push({ id, changes })
+  }
+
+  const beforeLinks = linksOf(before)
+  const afterLinks = linksOf(after)
+  const links = {
+    added: missingFrom(afterLinks, beforeLinks).sort(compareLinks),
+    removed: missingFrom(beforeLinks, afterLinks).sort(compareLinks),
+  }
+
+  const release: ReleaseFieldChange[] = []
+  for (const field of ['startDate', 'targetDate'] as const) {
+    const b = before.release[field] ?? null
+    const a = after.release[field] ?? null
+    if (b !== a) release.push({ field, before: b, after: a })
+  }
+
+  const beforeStreams = new Set(before.workstreams)
+  const afterStreams = new Set(after.workstreams)
+  const workstreams = {
+    added: sortedStrings(afterStreams).filter((name) => !beforeStreams.has(name)),
+    removed: sortedStrings(beforeStreams).filter((name) => !afterStreams.has(name)),
+  }
+
+  const beforeForecast = schedule(before)
+  const afterForecast = schedule(after)
+  const gates: GateChange[] = []
+  for (const gate of GATES) {
+    const b = gateState(before, gate)
+    const a = gateState(after, gate)
+    if (b !== a) gates.push({ gate, before: b, after: a })
+  }
+  // slipDays(target, finish) is positive when `finish` is later, so (before, after) gives +n for "n working days later".
+  // `|| 0` keeps a result of -0 out of the output.
+  const deltaWorkingDays = slipDays(beforeForecast.finishDate, afterForecast.finishDate) || 0
+
+  return {
+    unchanged:
+      release.length === 0 &&
+      workstreams.added.length === 0 &&
+      workstreams.removed.length === 0 &&
+      added.length === 0 &&
+      removed.length === 0 &&
+      changed.length === 0 &&
+      links.added.length === 0 &&
+      links.removed.length === 0,
+    release,
+    workstreams,
+    tasks: { added, removed, changed },
+    links,
+    readiness: {
+      before: assessReadiness(before, beforeForecast).ready,
+      after: assessReadiness(after, afterForecast).ready,
+      gates,
+    },
+    forecast: {
+      beforeFinishDate: beforeForecast.finishDate,
+      afterFinishDate: afterForecast.finishDate,
+      deltaWorkingDays,
+      beforeSlipDays: beforeForecast.slipDays ?? null,
+      afterSlipDays: afterForecast.slipDays ?? null,
+    },
+  }
+}

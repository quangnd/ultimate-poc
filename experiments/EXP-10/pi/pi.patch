+// 5 Mon 01-12) unless a test says otherwise.
+
+const START = '2026-01-05'
+
+type Extra = { status?: Status; targetDate?: string; gate?: Gate; title?: string; ownerRole?: string }
+
+function task(id: string, stream: string, estimateDays: number, predecessors: string[] = [], extra: Extra = {}): Task {
+  return { id, title: id, stream, ownerRole: 'owner', status: 'todo', estimateDays, predecessors, ...extra }
+}
+
+/** Builds a document and checks the diff's precondition: it must pass `validateDocument`. */
+function doc(tasks: Task[], release: { startDate?: string; targetDate?: string } = {}, workstreams = ['FW', 'SPS', 'Security', 'App', 'QA']): ReleaseDocument {
+  const built: ReleaseDocument = { schemaVersion: 1, release: { startDate: START, ...release }, workstreams, tasks }
+  const result = validateDocument(built)
+  if (!result.ok) throw new Error(`test document is invalid: ${result.errors.map((e) => e.message).join('; ')}`)
+  return built
+}
+
+/**
+ * A (FW, 2 days) -> B (SPS, 1 day); four 0-day gates: fw-integrated after A, security-verified after B, app-integration
+ * done, qa-complete after both. A runs day 0-1, B day 2, so the release finishes on day 2 = Wed 2026-01-07.
+ */
+function baseTasks(): Task[] {
+  return [
+    task('A', 'FW', 2),
+    task('B', 'SPS', 1, ['A']),
+    task('G-FW', 'FW', 0, ['A'], { gate: 'fw-integrated' }),
+    task('G-SEC', 'Security', 0, ['B'], { gate: 'security-verified' }),
+    task('G-APP', 'App', 0, [], { gate: 'app-integration', status: 'done' }),
+    task('G-QA', 'QA', 0, ['G-FW', 'G-SEC'], { gate: 'qa-complete' }),
+  ]
+}
+
+const base = () => doc(baseTasks())
+
+/** The task without its `gate` property (an absent optional field, not `gate: undefined`). */
+function withoutGate(t: Task): Task {
+  const { gate: _gate, ...rest } = t
+  return rest
+}
+
+/** The base document with a 1-day qa-complete task `Q` instead of G-QA; a task without a gate must have 1 day or more. */
+function qaDoc(gate: boolean, extra: Task[] = []): ReleaseDocument {
+  const q = task('Q', 'QA', 1, ['G-FW', 'G-SEC'], gate ? { gate: 'qa-complete' } : {})
+  return doc([...baseTasks().filter((t) => t.id !== 'G-QA'), q, ...extra])
+}
+
+/** The base tasks with one task replaced by `patch(task)`. */
+function edited(id: string, patch: (t: Task) => Task): ReleaseDocument {
+  return doc(baseTasks().map((t) => (t.id === id ? patch(t) : t)))
+}
+
+function fixture(): ReleaseDocument {

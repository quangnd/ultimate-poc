+describe('9. pure and order-independent', () => {
+  /** Deep freeze: a write to an input would throw in strict mode (ES modules are strict). */
+  function deepFreeze<T>(value: T): T {
+    if (typeof value === 'object' && value !== null) {
+      Object.values(value).forEach(deepFreeze)
+      Object.freeze(value)
+    }
+    return value
+  }
+
+  const pair = (): [ReleaseDocument, ReleaseDocument] => {
+    const before = fixture()
+    const after = fixture()
+    after.tasks = after.tasks.filter((t) => t.id !== 'APP-04' && t.id !== 'QA-01')
+    for (const t of after.tasks) t.predecessors = t.predecessors.filter((p) => p !== 'APP-04' && p !== 'QA-01')
+    after.tasks.find((t) => t.id === 'FW-03')!.estimateDays = 8
+    after.tasks.find((t) => t.id === 'FW-04')!.predecessors = ['FW-02', 'FW-03']
+    after.tasks.find((t) => t.id === 'SEC-02')!.status = 'done'
+    after.tasks.push(task('ZZ-1', 'App', 2, ['APP-01', 'FW-02']), task('AA-1', 'QA', 1))
+    before.workstreams.push('Legacy')
+    after.workstreams = ['QA', 'Ops', 'FW', 'SPS', 'App', 'Security']
+    after.release = { startDate: '2027-01-11' }
+    return [validated(before), validated(after)]
+  }
+  const validated = (d: ReleaseDocument) => doc(d.tasks, d.release, d.workstreams)
+
+  it('has the pair exercising every part of the result', () => {
+    const [before, after] = pair()
+    const diff = diffReleases(before, after)
+    expect(diff.unchanged).toBe(false)
+    expect(diff.release.length).toBeGreaterThan(0)
+    expect(diff.workstreams.added.length + diff.workstreams.removed.length).toBeGreaterThan(0)
+    expect(diff.tasks.added.length).toBeGreaterThan(0)
+    expect(diff.tasks.removed.length).toBeGreaterThan(0)
+    expect(diff.tasks.changed.length).toBeGreaterThan(0)
+    expect(diff.links.added.length).toBeGreaterThan(0)
+    expect(diff.links.removed.length).toBeGreaterThan(0)
+  })
+
+  it('does not mutate its inputs and is repeatable', () => {
+    const [before, after] = pair()
+    const snapshot = structuredClone([before, after])
+    deepFreeze(before)
+    deepFreeze(after)
+    const first = diffReleases(before, after)
+    expect(diffReleases(before, after)).toEqual(first)
+    expect([before, after]).toEqual(snapshot)
+  })
+
+  it('does not share arrays or objects with its inputs', () => {
+    const [before, after] = pair()
+    const diff = diffReleases(before, after)
+    const copy = structuredClone(diff)
+    // writing to the result must not reach the inputs (the inputs are compared with a snapshot taken first)
+    const snapshot = structuredClone([before, after])
+    diff.tasks.added.push('x')
+    diff.workstreams.added.push('x')
+    diff.links.added.push({ from: 'x', to: 'y' })
+    expect([before, after]).toEqual(snapshot)
+    expect(copy.tasks.added).not.toContain('x')
+  })
+
+  /** Deterministic permutations of an array (no randomness): 0 reversed, 1 rotated by three, 2 odd positions first. */
+  const permute = <T>(items: readonly T[], k: number): T[] =>
+    k === 0
+      ? [...items].reverse()
+      : k === 1
+        ? [...items.slice(3), ...items.slice(0, 3)]
+        : [...items.filter((_, i) => i % 2 === 1), ...items.filter((_, i) => i % 2 === 0)]
+
+  it('gives the same result for any order of tasks, predecessors and workstreams in either document', () => {
+    const [before, after] = pair()
+    const expected = diffReleases(before, after)
+    const shuffle = (d: ReleaseDocument, k: number): ReleaseDocument => ({
+      ...d,
+      workstreams: permute(d.workstreams, k),
+      tasks: permute(
+        d.tasks.map((t) => ({ ...t, predecessors: permute(t.predecessors, k) })),
+        k,
+      ),
+    })
+    for (let k = 0; k < 3; k++) {
+      expect(diffReleases(shuffle(before, k), after)).toEqual(expected)
+      expect(diffReleases(before, shuffle(after, k))).toEqual(expected)
+      expect(diffReleases(shuffle(before, k), shuffle(after, (k + 1) % 3))).toEqual(expected)
+    }
+  })
+
+  it('gives the same result when predecessors are reversed', () => {
+    const [before, after] = pair()
+    const reversed = (d: ReleaseDocument): ReleaseDocument => ({ ...d, tasks: d.tasks.map((t) => ({ ...t, predecessors: [...t.predecessors].reverse() })) })
+    expect(diffReleases(reversed(before), reversed(after))).toEqual(diffReleases(before, after))
+  })
+})

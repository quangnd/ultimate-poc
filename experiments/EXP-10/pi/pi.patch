+    expect(gates.map((g) => g.gate)).toEqual(GATES.filter((g) => gates.some((c) => c.gate === g)))
+    expect(diffReleases(allDone(), base()).readiness.gates.map((g) => [g.before, g.after])).toEqual([
+      ['done', 'open'],
+      ['done', 'open'],
+      ['done', 'open'],

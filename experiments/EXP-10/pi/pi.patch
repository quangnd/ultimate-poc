+      beforeSlipDays: schedule(before).slipDays ?? null,
+      afterSlipDays: schedule(after).slipDays ?? null,
+    })
+    // before: finish day 2 = Wed 01-07, 2 working days early; after: day 5 = Mon 01-12, 1 working day late
+    expect(diff.forecast).toMatchObject({ beforeFinishDate: '2026-01-07', afterFinishDate: '2026-01-12', beforeSlipDays: -2, afterSlipDays: 1 })
+
+    const noTarget = diffReleases(base(), after)
+    expect(noTarget.forecast).toMatchObject({ beforeSlipDays: null, afterSlipDays: 1 })
+    expect(diffReleases(after, base()).forecast).toMatchObject({ beforeSlipDays: 1, afterSlipDays: null })
+    expect(diffReleases(base(), base()).forecast).toMatchObject({ beforeSlipDays: null, afterSlipDays: null })
+  })
+
+  it('counts working days: positive when the after finish is later, negative when earlier, 0 when equal', () => {
+    const slower = edited('A', (t) => ({ ...t, estimateDays: 5 })) // finish Mon 01-12, 3 working days after Wed 01-07
+    const faster = edited('A', (t) => ({ ...t, estimateDays: 1 })) // A day 0, B day 1: finish Tue 01-06
+    expect(diffReleases(base(), slower).forecast.deltaWorkingDays).toBe(3)
+    expect(diffReleases(slower, base()).forecast.deltaWorkingDays).toBe(-3)
+    expect(diffReleases(base(), faster).forecast.deltaWorkingDays).toBe(-1)
+    expect(diffReleases(faster, base()).forecast.deltaWorkingDays).toBe(1)
+    expect(diffReleases(base(), edited('A', (t) => ({ ...t, title: 'x' }))).forecast.deltaWorkingDays).toBe(0)
+  })
+
+  it('does not report -0', () => {
+    expect(Object.is(diffReleases(base(), base()).forecast.deltaWorkingDays, 0)).toBe(true)
+  })
+
+  it('measures the firmware-delay scenario of the sample: FW-03 5 -> 8 days is +3 working days, -2 -> +1 against the target', () => {
+    const before = fixture()
+    const after = { ...before, tasks: before.tasks.map((t) => (t.id === 'FW-03' ? { ...t, estimateDays: 8 } : t)) }
+    const diff = diffReleases(before, after)
+    expect(diff.tasks.changed).toEqual([{ id: 'FW-03', changes: [{ field: 'estimateDays', before: 5, after: 8 }] }])
+    expect(diff.forecast).toEqual({

+    const saturday = doc(baseTasks(), { startDate: '2026-01-10' })
+    expect(diffReleases(week, saturday).forecast.deltaWorkingDays).toBe(0)
+    expect(diffReleases(week, saturday).unchanged).toBe(false) // but the start date still differs
+    expect(diffReleases(base(), saturday).forecast).toMatchObject({ afterFinishDate: '2026-01-14', deltaWorkingDays: 5 })

+  })
+
+  it('reports missing for a gate no task has', () => {
+    const noApp = doc(baseTasks().filter((t) => t.id !== 'G-APP'))
+    expect(diffReleases(base(), noApp).readiness.gates).toEqual([{ gate: 'app-integration', before: 'done', after: 'missing' }])
+    expect(diffReleases(noApp, base()).readiness.gates).toEqual([{ gate: 'app-integration', before: 'missing', after: 'done' }])
+    const noQa = doc(baseTasks().filter((t) => t.id !== 'G-QA'))

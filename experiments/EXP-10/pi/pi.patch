diff --git a/src/web/ImportPreview.tsx b/src/web/ImportPreview.tsx
new file mode 100644
index 0000000..096f96b
--- /dev/null
+++ b/src/web/ImportPreview.tsx
@@ -0,0 +1,239 @@
+/** The import preview (US-07): what replacing the stored release with the chosen file would change. */
+import { useMemo } from 'react'
+import { diffReleases, type FieldChange, type GateState, type ReleaseDiff, type TaskField } from '../domain/diff'
+import type { ReleaseDocument, Status } from '../domain/types'
+import { deltaText, formatDate, slipText, slipTone, STATUS_LABEL } from './view'
+
+const FIELD_LABEL: Record<TaskField, string> = {
+  title: 'Title',
+  stream: 'Stream',
+  ownerRole: 'Owner role',
+  status: 'Status',
+  estimateDays: 'Estimate (working days)',
+  targetDate: 'Target date',
+  gate: 'Gate',
+}
+
+const GATE_STATE_LABEL: Record<GateState, string> = { missing: 'Not defined', open: 'Not done', done: 'Done' }
+
+const plural = (n: number, one: string, many = `${one}s`) => `${n} ${n === 1 ? one : many}`
+
+interface Props {
+  /** What is stored now, never the editor's unsaved draft. */
+  stored: ReleaseDocument
+  imported: ReleaseDocument
+  /** Unsaved changes in the editor, which this preview does not include. */
+  unsavedChanges: number
+}
+
+export function ImportPreview({ stored, imported, unsavedChanges }: Props) {
+  const diff = useMemo(() => diffReleases(stored, imported), [stored, imported])
+  return (
+    <section className="import-preview" aria-labelledby="import-preview-title">
+      <h2 id="import-preview-title">What would change</h2>
+      {unsavedChanges > 0 && (
+        <p className="muted">
+          This compares the file with the <strong>stored</strong> release, not with the {plural(unsavedChanges, 'unsaved edit')} in the
+          editor.
+        </p>
+      )}
+      {diff.unchanged ? (
+        <p>
+          <strong>This file matches the stored release.</strong> No task, link, date or stream differs, so replacing it changes nothing.
+        </p>
+      ) : (
+        <>
+          <TaskChanges diff={diff} stored={stored} imported={imported} />
+          <LinkChanges diff={diff} />
+          <ReleaseChanges diff={diff} />
+          <ReadinessChange diff={diff} />
+          <ForecastChange diff={diff} stored={stored} imported={imported} />
+        </>
+      )}
+    </section>
+  )
+}
+
+function Block({ title, tag, children }: { title: string; tag?: React.ReactNode; children: React.ReactNode }) {
+  return (
+    <div className="preview-block">
+      <h3>
+        {title}
+        {tag}
+      </h3>
+      {children}
+    </div>
+  )
+}
+
+function Id({ id }: { id: string }) {
+  return <span className="id">{id}</span>
+}
+
+const KIND_LABEL = { added: 'Added', removed: 'Removed', changed: 'Changed' } as const
+
+function Kind({ kind }: { kind: keyof typeof KIND_LABEL }) {
+  return <span className={`change-kind change-${kind}`}>{KIND_LABEL[kind]}</span>
+}
+
+/** "old → new": the old value muted, the new one strong. The text reads the same without the styling. */
+function FromTo({ before, after }: { before: React.ReactNode; after: React.ReactNode }) {
+  return (
+    <span className="from-to">
+      <span className="change-old">{before}</span> → <strong>{after}</strong>
+    </span>
+  )
+}
+
+/** A task field value as the dashboard shows it: status words, formatted dates, "none" for an absent optional field. */
+function fieldValue({ field, before, after }: FieldChange, side: 'before' | 'after'): React.ReactNode {
+  const value = side === 'before' ? before : after
+  if (value === null) return <span className="muted">none</span>
+  if (value === '') return <span className="muted">empty</span>
+  if (field === 'status') return STATUS_LABEL[value as Status]
+  if (field === 'targetDate') return formatDate(value as string)
+  return String(value)
+}
+
+function TaskChanges({ diff, stored, imported }: { diff: ReleaseDiff; stored: ReleaseDocument; imported: ReleaseDocument }) {
+  const { added, removed, changed } = diff.tasks
+  if (added.length + removed.length + changed.length === 0) return null
+  const titles = (doc: ReleaseDocument) => new Map(doc.tasks.map((t) => [t.id, t.title]))
+  const storedTitles = titles(stored)
+  const importedTitles = titles(imported)
+  return (
+    <Block title={`Tasks: ${added.length} added, ${removed.length} removed, ${changed.length} changed`}>
+      <ul className="change-list">
+        {added.map((id) => (
+          <li key={`added-${id}`}>
+            <Kind kind="added" /> <Id id={id} /> <span>{importedTitles.get(id)}</span>
+          </li>
+        ))}
+        {removed.map((id) => (
+          <li key={`removed-${id}`}>
+            <Kind kind="removed" /> <Id id={id} /> <span>{storedTitles.get(id)}</span>
+          </li>
+        ))}
+        {changed.map(({ id, changes }) => (
+          <li key={`changed-${id}`}>
+            <Kind kind="changed" /> <Id id={id} /> <span>{importedTitles.get(id)}</span>
+            <ul className="field-changes">
+              {changes.map((change) => (
+                <li key={change.field}>
+                  <span className="change-field">{FIELD_LABEL[change.field]}</span>{' '}
+                  <FromTo before={fieldValue(change, 'before')} after={fieldValue(change, 'after')} />
+                </li>
+              ))}
+            </ul>
+          </li>
+        ))}
+      </ul>
+    </Block>
+  )
+}
+
+function LinkChanges({ diff }: { diff: ReleaseDiff }) {
+  const { added, removed } = diff.links
+  if (added.length + removed.length === 0) return null
+  const item = (kind: 'added' | 'removed', { from, to }: { from: string; to: string }) => (
+    <li key={`${kind}-${JSON.stringify([from, to])}`}>
+      <Kind kind={kind} /> <Id id={from} /> → <Id id={to} />
+    </li>
+  )
+  return (
+    <Block title={`Links: ${added.length} added, ${removed.length} removed`}>
+      <ul className="change-list">
+        {added.map((link) => item('added', link))}
+        {removed.map((link) => item('removed', link))}
+      </ul>
+    </Block>
+  )
+}
+
+function ReleaseChanges({ diff }: { diff: ReleaseDiff }) {
+  const { release, workstreams } = diff
+  if (release.length + workstreams.added.length + workstreams.removed.length === 0) return null
+  const date = (value: string | null) => (value === null ? <span className="muted">none</span> : formatDate(value))
+  return (
+    <Block title="Release dates and streams">
+      <ul className="change-list">
+        {release.map((c) => (
+          <li key={c.field}>
+            <span className="change-field">{c.field === 'startDate' ? 'Start date' : 'Target date'}</span>{' '}
+            <FromTo before={date(c.before)} after={date(c.after)} />
+          </li>
+        ))}
+        {workstreams.added.length > 0 && (
+          <li>
+            <Kind kind="added" /> <span>{plural(workstreams.added.length, 'stream')}: {workstreams.added.join(', ')}</span>
+          </li>
+        )}
+        {workstreams.removed.length > 0 && (
+          <li>
+            <Kind kind="removed" /> <span>{plural(workstreams.removed.length, 'stream')}: {workstreams.removed.join(', ')}</span>
+          </li>
+        )}
+      </ul>
+    </Block>
+  )
+}
+
+function Verdict({ ready }: { ready: boolean }) {
+  return <span className={ready ? 'verdict-chip verdict-chip-ready' : 'verdict-chip verdict-chip-not-ready'}>{ready ? 'Ready' : 'Not ready'}</span>
+}
+
+function ReadinessChange({ diff }: { diff: ReleaseDiff }) {
+  const { before, after, gates } = diff.readiness
+  return (
+    <Block title="Readiness">
+      <p>
+        <Verdict ready={before} /> → <Verdict ready={after} />
+        {before === after && <span className="muted"> (no change)</span>}
+      </p>
+      {gates.length > 0 && (
+        <ul className="change-list">
+          {gates.map(({ gate, before: was, after: now }) => (
+            <li key={gate}>
+              <span className="change-field">
+                Gate <code>{gate}</code>
+              </span>{' '}
+              <FromTo before={GATE_STATE_LABEL[was]} after={GATE_STATE_LABEL[now]} />
+            </li>
+          ))}
+        </ul>
+      )}
+    </Block>
+  )
+}
+
+function ForecastChange({ diff, stored, imported }: { diff: ReleaseDiff; stored: ReleaseDocument; imported: ReleaseDocument }) {
+  const f = diff.forecast
+  // The dashboard says "Complete" instead of a date when nothing is left to do. The preview keeps the forecast values
+  // (US-07) and marks such a side "complete", so a release that finishes earlier because it is all done still shows how much.
+  const beforeDone = stored.tasks.every((t) => t.status === 'done')
+  const afterDone = imported.tasks.every((t) => t.status === 'done')
+  const finish = (done: boolean, date: string) => (
+    <>
+      {formatDate(date)}
+      {done && <span className="muted"> (complete)</span>}
+    </>
+  )
+  const slip = (value: number | null) =>
+    value === null ? <span className="muted">no target</span> : <span className={`slip slip-${slipTone(value)}`}>{slipText(value)}</span>
+  return (
+    <Block title="Forecast" tag={<span className="estimate-tag">Estimate, not a commitment</span>}>
+      <ul className="change-list">
+        <li>
+          <span className="change-field">Estimated finish</span>{' '}
+          <FromTo before={finish(beforeDone, f.beforeFinishDate)} after={finish(afterDone, f.afterFinishDate)} />
+          <span className={`delta ${f.deltaWorkingDays > 0 ? 'delta-later' : ''}`}>{deltaText(f.deltaWorkingDays)}</span>
+        </li>
+        {(f.beforeSlipDays !== null || f.afterSlipDays !== null) && (
+          <li>
+            <span className="change-field">Slip against the target</span> <FromTo before={slip(f.beforeSlipDays)} after={slip(f.afterSlipDays)} />
+          </li>
+        )}
+      </ul>
+    </Block>
+  )
+}

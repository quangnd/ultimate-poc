+import { readFileSync } from 'node:fs'
+import { createElement } from 'react'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { describe, expect, it } from 'vitest'
+import type { ReleaseDocument } from '../../src/domain/types'
+import { ImportPreview } from '../../src/web/ImportPreview'
+
+const sample = JSON.parse(readFileSync('fixtures/release.json', 'utf8')) as ReleaseDocument
+const allDone: ReleaseDocument = { ...structuredClone(sample), tasks: sample.tasks.map((t) => ({ ...structuredClone(t), status: 'done' as const })) }
+
+/** The preview as text: tags dropped, entities left as they are (none of the asserted strings contain any). */
+const text = (stored: ReleaseDocument, imported: ReleaseDocument) =>
+  renderToStaticMarkup(createElement(ImportPreview, { stored, imported, unsavedChanges: 0 }))
+    .replace(/<[^>]+>/g, ' ')
+    .replace(/\s+/g, ' ')
+
+describe('import preview forecast when a release has nothing left to do', () => {
+  it('importing an all-done release still shows both finish dates, the delta and both slips (US-07)', () => {
+    const shown = text(sample, allDone)
+    expect(shown).toContain('Wed 10 Feb 2027 → Fri 1 Jan 2027 (complete)')
+    expect(shown).toContain('-28 working days earlier')
+    expect(shown).toContain('2 working days early → 30 working days early')
+  })
+
+  it('replacing an all-done release with an open one shows them too', () => {
+    const shown = text(allDone, sample)
+    expect(shown).toContain('Fri 1 Jan 2027 (complete) → Wed 10 Feb 2027')
+    expect(shown).toContain('+28 working days later')
+    expect(shown).toContain('30 working days early → 2 working days early')
+  })
+})

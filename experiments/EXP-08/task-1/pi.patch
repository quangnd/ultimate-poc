@@ -0,0 +1,50 @@
+/** Add/remove finish-to-start dependency links (US-03, ADR-002 §9). Pure: no I/O, no clock, no randomness. */
+import type { ReleaseDocument, Task } from './types'
+import { validateDocument } from './validate'
+
+export interface LinkError {
+  code: string
+  message: string
+  taskId?: string
+  /** only for code 'cycle': as in ValidationError.cycle */
+  cycle?: string[]
+}
+export type LinkResult = { ok: true; document: ReleaseDocument } | { ok: false; errors: LinkError[] }
+
+const fail = (code: string, message: string, taskId: string): LinkResult => ({ ok: false, errors: [{ code, message, taskId }] })
+
+/** A new document whose task `taskId` has `predecessors` replaced; the input is not touched. */
+const withPredecessors = (doc: ReleaseDocument, taskId: string, update: (preds: string[]) => string[]): ReleaseDocument => ({
+  ...doc,
+  tasks: doc.tasks.map((t): Task => (t.id === taskId ? { ...t, predecessors: update(t.predecessors) } : t)),
+})
+
+/** Make `predecessorId` a finish-to-start predecessor of `taskId`. Precondition: `doc` passes `validateDocument`. */
+export function addLink(doc: ReleaseDocument, taskId: string, predecessorId: string): LinkResult {
+  const target = doc.tasks.find((t) => t.id === taskId)
+  if (!target) return fail('unknown-task', `unknown task ${taskId}`, taskId)
+  if (predecessorId === taskId) return fail('self-predecessor', `task ${taskId} lists itself as a predecessor`, taskId)
+  if (!doc.tasks.some((t) => t.id === predecessorId)) {
+    return fail('unknown-predecessor', `unknown predecessor ${predecessorId} on task ${taskId}`, taskId)
+  }
+  if (target.predecessors.includes(predecessorId)) {
+    return fail('repeated-predecessor', `repeated predecessor ${predecessorId} on task ${taskId}`, taskId)
+  }
+
+  const document = withPredecessors(doc, taskId, (preds) => [...preds, predecessorId])
+  const result = validateDocument(document)
+  if (result.ok) return { ok: true, document }
+  // The input was valid, so the only error the new link can cause here is a cycle; report the validator's own error.
+  const cycles = result.errors.filter((e) => e.code === 'cycle')
+  return { ok: false, errors: cycles.length > 0 ? cycles : result.errors }
+}
+
+/** Remove `predecessorId` from the predecessors of `taskId`. Precondition: `doc` passes `validateDocument`. */
+export function removeLink(doc: ReleaseDocument, taskId: string, predecessorId: string): LinkResult {
+  const target = doc.tasks.find((t) => t.id === taskId)
+  if (!target) return fail('unknown-task', `unknown task ${taskId}`, taskId)
+  if (!target.predecessors.includes(predecessorId)) {
+    return fail('unknown-link', `task ${predecessorId} is not a predecessor of task ${taskId}`, taskId)
+  }
+  return { ok: true, document: withPredecessors(doc, taskId, (preds) => preds.filter((p) => p !== predecessorId)) }
+}
diff --git a/tests/domain/links.test.ts b/tests/domain/links.test.ts
new file mode 100644
index 0000000..858ddd3
--- /dev/null
+++ b/tests/domain/links.test.ts
@@ -0,0 +1,240 @@
+import { readFileSync } from 'node:fs'
+import { describe, expect, it } from 'vitest'
+import { addLink, removeLink, type LinkResult } from '../../src/domain/links'
+import type { ReleaseDocument, Task } from '../../src/domain/types'
+import { validateDocument } from '../../src/domain/validate'
+
+const task = (id: string, predecessors: string[] = [], over: Partial<Task> = {}): Task => ({
+  id,
+  title: `Task ${id}`,
+  stream: 'FW',
+  ownerRole: 'owner',
+  status: 'todo',
+  estimateDays: 2,
+  predecessors,
+  ...over,
+})
+
+// A <- B <- C chain, D independent with two predecessors, E gate.
+const makeDoc = (): ReleaseDocument => ({
+  schemaVersion: 1,
+  release: { startDate: '2026-01-05', targetDate: '2026-03-31' },
+  workstreams: ['FW', 'QA'],
+  tasks: [
+    task('C', ['B']),
+    task('A'),
+    task('B', ['A']),
+    task('D', ['A', 'B'], { stream: 'QA', targetDate: '2026-02-02' }),
+    task('E', ['D'], { estimateDays: 0, gate: 'qa-complete' }),
+  ],
+})
+
+const okDoc = (result: LinkResult): ReleaseDocument => {
+  if (!result.ok) throw new Error(`expected success, got ${JSON.stringify(result.errors)}`)
+  return result.document
+}
+const errorsOf = (result: LinkResult) => {
+  if (result.ok) throw new Error('expected failure')
+  return result.errors
+}
+
+const deepFreeze = <T>(value: T): T => {
+  if (typeof value === 'object' && value !== null) {
+    for (const v of Object.values(value)) deepFreeze(v)
+    Object.freeze(value)
+  }
+  return value
+}
+
+/** The document a caller would get by appending/removing the link by hand. */
+const edited = (doc: ReleaseDocument, taskId: string, update: (preds: string[]) => string[]): ReleaseDocument => ({
+  ...doc,
+  tasks: doc.tasks.map((t) => (t.id === taskId ? { ...t, predecessors: update(t.predecessors) } : t)),
+})
+
+const loadFixture = (): ReleaseDocument => {
+  const result = validateDocument(JSON.parse(readFileSync('fixtures/release.json', 'utf8')))
+  if (!result.ok) throw new Error('fixture must be valid')
+  return result.document
+}
+
+describe('precondition', () => {
+  it('the test document is valid', () => {
+    expect(validateDocument(makeDoc()).ok).toBe(true)
+  })
+})
+
+describe('addLink', () => {
+  it('appends the predecessor and leaves everything else unchanged', () => {
+    const doc = makeDoc()
+    const out = okDoc(addLink(doc, 'D', 'C'))
+    const expected = makeDoc()
+    expected.tasks[3]!.predecessors = ['A', 'B', 'C']
+    expect(out).toEqual(expected)
+    expect(out.tasks.map((t) => t.id)).toEqual(['C', 'A', 'B', 'D', 'E'])
+    expect(validateDocument(out).ok).toBe(true)
+  })
+
+  it('adds a first predecessor to a task with none', () => {
+    const doc = makeDoc()
+    doc.tasks.push(task('F'))
+    const out = okDoc(addLink(doc, 'A', 'F'))
+    expect(out.tasks[1]!.predecessors).toEqual(['F'])
+    expect(out.tasks.slice(2)).toEqual(doc.tasks.slice(2))
+    expect(validateDocument(out).ok).toBe(true)
+  })
+
+  it('does not mutate the input on success or failure', () => {
+    const doc = makeDoc()
+    const before = structuredClone(doc)
+    okDoc(addLink(doc, 'E', 'C'))
+    errorsOf(addLink(doc, 'A', 'C'))
+    errorsOf(addLink(doc, 'X', 'A'))
+    errorsOf(addLink(doc, 'A', 'X'))
+    errorsOf(addLink(doc, 'A', 'A'))
+    errorsOf(addLink(doc, 'B', 'A'))
+    expect(doc).toEqual(before)
+  })
+
+  it('rejects an unknown task', () => {
+    expect(errorsOf(addLink(makeDoc(), 'X', 'A'))).toEqual([{ code: 'unknown-task', message: expect.any(String), taskId: 'X' }])
+  })
+
+  it('rejects an unknown predecessor', () => {
+    const errors = errorsOf(addLink(makeDoc(), 'A', 'X'))
+    expect(errors).toEqual([{ code: 'unknown-predecessor', message: 'unknown predecessor X on task A', taskId: 'A' }])
+  })
+
+  it('rejects a self link', () => {
+    expect(errorsOf(addLink(makeDoc(), 'B', 'B')).map((e) => e.code)).toEqual(['self-predecessor'])
+  })
+
+  it('rejects an existing link', () => {
+    expect(errorsOf(addLink(makeDoc(), 'D', 'B')).map((e) => e.code)).toEqual(['repeated-predecessor'])
+  })
+
+  it('rejects a link that closes a cycle with the validator cycle and message', () => {
+    const doc = makeDoc()
+    const errors = errorsOf(addLink(doc, 'A', 'C'))
+    const resulting = { ...doc, tasks: doc.tasks.map((t) => (t.id === 'A' ? { ...t, predecessors: ['C'] } : t)) }
+    const validation = validateDocument(resulting)
+    if (validation.ok) throw new Error('expected a cycle')
+    expect(errors).toHaveLength(1)
+    expect(errors[0]!.code).toBe('cycle')
+    expect(errors[0]).toEqual(validation.errors.find((e) => e.code === 'cycle'))
+    expect(errors[0]!.cycle).toEqual(['A', 'C', 'B'])
+    expect(errors[0]!.message).toBe('dependency cycle: A -> C -> B -> A')
+  })
+
+  it('rejects a direct two-task cycle', () => {
+    const errors = errorsOf(addLink(makeDoc(), 'A', 'B'))
+    expect(errors.map((e) => e.code)).toEqual(['cycle'])
+    expect(errors[0]!.cycle).toEqual(['A', 'B'])
+  })
+
+  it('is deterministic', () => {
+    expect(addLink(makeDoc(), 'A', 'E')).toEqual(addLink(makeDoc(), 'A', 'E'))
+    expect(addLink(makeDoc(), 'E', 'C')).toEqual(addLink(makeDoc(), 'E', 'C'))
+  })
+})
+
+describe('removeLink', () => {
+  it('removes the predecessor, keeps the order of the rest and everything else', () => {
+    const doc = makeDoc()
+    doc.tasks[3]!.predecessors = ['A', 'C', 'B']
+    const out = okDoc(removeLink(doc, 'D', 'C'))
+    const expected = makeDoc()
+    expect(out).toEqual(expected)
+    expect(validateDocument(out).ok).toBe(true)
+  })
+
+  it('removes the only predecessor', () => {
+    const out = okDoc(removeLink(makeDoc(), 'B', 'A'))
+    expect(out.tasks[2]!.predecessors).toEqual([])
+    expect(validateDocument(out).ok).toBe(true)
+  })
+
+  it('does not mutate the input on success or failure', () => {
+    const doc = makeDoc()
+    const before = structuredClone(doc)
+    okDoc(removeLink(doc, 'D', 'A'))
+    errorsOf(removeLink(doc, 'D', 'C'))
+    errorsOf(removeLink(doc, 'X', 'A'))
+    expect(doc).toEqual(before)
+  })
+
+  it('rejects an unknown task', () => {
+    expect(errorsOf(removeLink(makeDoc(), 'X', 'A'))).toEqual([{ code: 'unknown-task', message: expect.any(String), taskId: 'X' }])
+  })
+
+  it('rejects a link that does not exist', () => {
+    expect(errorsOf(removeLink(makeDoc(), 'D', 'C'))).toEqual([{ code: 'unknown-link', message: expect.any(String), taskId: 'D' }])
+    expect(errorsOf(removeLink(makeDoc(), 'A', 'X'))).toEqual([{ code: 'unknown-link', message: expect.any(String), taskId: 'A' }])
+  })
+
+  it('is deterministic', () => {
+    expect(removeLink(makeDoc(), 'D', 'A')).toEqual(removeLink(makeDoc(), 'D', 'A'))
+  })
+})
+
+describe('frozen input', () => {
+  it('neither function writes to a deeply frozen document', () => {
+    const doc = deepFreeze(makeDoc())
+    expect(okDoc(addLink(doc, 'E', 'C')).tasks[4]!.predecessors).toEqual(['D', 'C'])
+    expect(okDoc(removeLink(doc, 'D', 'A')).tasks[3]!.predecessors).toEqual(['B'])
+    for (const [t, p] of [['A', 'C'], ['X', 'A'], ['A', 'X'], ['A', 'A'], ['B', 'A']] as const) errorsOf(addLink(doc, t, p))
+    errorsOf(removeLink(doc, 'D', 'C'))
+    expect(doc).toEqual(makeDoc())
+  })
+})
+
+describe('single error per failure', () => {
+  it('reports only unknown-task when the task and predecessor are both unknown', () => {
+    expect(errorsOf(addLink(makeDoc(), 'X', 'Y'))).toEqual([{ code: 'unknown-task', message: expect.any(String), taskId: 'X' }])
+    expect(errorsOf(addLink(makeDoc(), 'X', 'X'))).toEqual([{ code: 'unknown-task', message: expect.any(String), taskId: 'X' }])
+    expect(errorsOf(removeLink(makeDoc(), 'X', 'Y'))).toEqual([{ code: 'unknown-task', message: expect.any(String), taskId: 'X' }])
+  })
+
+  it('uses the validator messages for self and repeated links', () => {
+    expect(errorsOf(addLink(makeDoc(), 'B', 'B'))).toEqual([
+      { code: 'self-predecessor', message: 'task B lists itself as a predecessor', taskId: 'B' },
+    ])
+    expect(errorsOf(addLink(makeDoc(), 'D', 'B'))).toEqual([
+      { code: 'repeated-predecessor', message: 'repeated predecessor B on task D', taskId: 'D' },
+    ])
+  })
+})
+
+describe('against the synthetic fixture', () => {
+  it('addLink agrees with validating the hand-edited document for every task pair', () => {
+    const doc = deepFreeze(loadFixture())
+    let cycles = 0
+    for (const target of doc.tasks) {
+      for (const pred of doc.tasks) {
+        if (pred.id === target.id || target.predecessors.includes(pred.id)) continue
+        const manual = edited(doc, target.id, (ps) => [...ps, pred.id])
+        const validation = validateDocument(manual)
+        const result = addLink(doc, target.id, pred.id)
+        if (validation.ok) {
+          expect(result).toEqual({ ok: true, document: manual })
+        } else {
+          cycles++
+          expect(validation.errors.map((e) => e.code)).toEqual(['cycle'])
+          expect(result).toEqual({ ok: false, errors: validation.errors })
+        }
+      }
+    }
+    expect(cycles).toBeGreaterThan(0)
+  })
+
+  it('removeLink removes every existing link to a valid document', () => {
+    const doc = deepFreeze(loadFixture())
+    for (const target of doc.tasks) {
+      for (const pred of target.predecessors) {
+        const out = okDoc(removeLink(doc, target.id, pred))
+        expect(out).toEqual(edited(doc, target.id, (ps) => ps.filter((p) => p !== pred)))
+        expect(validateDocument(out).ok).toBe(true)
+      }
+    }
+  })
+})
